    &lt;DELIMITER&gt;|&lt;/DELIMITER&gt;
    &lt;NO_DATA&gt;&lt;/NO_DATA&gt;
    &lt;ROWSKIPS&gt;0&lt;/ROWSKIPS&gt;
    &lt;ROWCOUNT&gt;1&lt;/ROWCOUNT&gt;

    &lt;OPTIONS&gt;
        &lt;item&gt;
            &lt;TEXT&gt;BSTYP EQ 'F' AND BSART EQ '${property.DocumentType}'&lt;/TEXT&gt;
